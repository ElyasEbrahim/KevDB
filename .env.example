# Copy to .env and fill in your own keys. None of them is needed for the library, the tests or the local open models.

# Official Jev API (https://console.typesafe.ai/keys). Every real Jev task goes through it.
TYPESAFE_API_KEY=

# Third-party platform OpenCode Zen (https://opencode.ai/zen). Used only for comparison:
# the LLM baselines only it offered at the time, and the official-versus-third-party route comparison.
OPENCODE_API_KEY=

# OpenRouter (https://openrouter.ai/settings/keys). Used only by experiments/database/: LLM baselines and the stronger upper-tier model.
# Needs a normal API key; a provisioning key can only read the balance and gets 401 when calling a model.
OPENROUTER_API_KEY=

# Cloudflare Workers AI (https://dash.cloudflare.com → Workers AI → REST API). Used only when experiments/database/p6_collect.py runs the hosted open model Clef.
# The token needs only Workers AI read permission; beyond the free 10,000 Neurons per day a paid Workers plan is required.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
